# Public site URL (sitemap, metadata)
NEXT_PUBLIC_SITE_URL=https://www.bluepikconsult.com

# Gmail SMTP for the enquiry form.
# GMAIL_APP_PASSWORD is a 16-character Google *App Password*, not your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on).
# Leave both empty in development: enquiries are then printed to the terminal instead of emailed.
GMAIL_USER=bluepikconsult@gmail.com
GMAIL_APP_PASSWORD=

# Where enquiries are delivered (defaults to GMAIL_USER)
ENQUIRY_TO_EMAIL=bluepikconsult@gmail.com
